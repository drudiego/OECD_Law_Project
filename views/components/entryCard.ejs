<!-- Card showing the entry from the database -->
<div class="card mt-3 ">
  <div class="card-header"></div>
  <div class="card-info d-flex flex-row ">
    <div class="card-info-text col-9">
      <div class="card-body">
        <h5 class="card-title">${statement.title}</h5>
        <p class="issue-tag">ISSUE</p>
        <p class="card-text"><i>${statement.description}</i></p>
      </div>
    </div>
    <div class="card-info-tags col-3">
      <div class="card-body tagStyle" id=${statement._id}>
        <p class="card-tag">${statement.year}</p>
        <p class="card-tag">${status}</p>
      </div>
      <div card-body tagStyle>



      </div>
    </div>
  </div>
</div>