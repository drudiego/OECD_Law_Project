 <!-- Functions for map, data entry and pagination -->
 <script>
   const entriesPerPage = 4; // Number of entries to display per page
   let currentPage = 1; // Current page number

   const results = <%- JSON.stringify(results) %>; // Array of statements
   //  console.log("results aqui", results);
   const countryCount = <%- JSON.stringify(countryCount) %>;
   const data = <%- JSON.stringify(data) %>; // Array of countryCount
   // console.log(countryCount);

   function scrollToResults() {
     const searchBar = document.getElementById('results-container');
     searchBar.scrollIntoView();
   }

   // Function to display the entries for the current page
   function displayEntries() {
     const entriesContainer = document.getElementById('entriesContainer');
     entriesContainer.innerHTML = ''; // Clear previous entries

     // Calculate the starting and ending indexes for the current page
     const start = (currentPage - 1) * entriesPerPage;
     const end = start + entriesPerPage;

     // Display entries for the current page
     for (let i = start; i < end && i < results.length; i++) {
       const result = results[i];
       const segments = result.item.segments;
       //  console.log("segments aqui", segments);
       let status = ""
       const hostCountries = []

       // Create DOM elements to display the statement's content
       const statementElement = document.createElement('a');
       statementElement.href = `/statements/${result.item._id}`;
       statementElement.classList.add('link-container', 'col-12');
       // Card for the entries from the database
       statementElement.innerHTML = `
              <%-include('./entryCardSearchResults') %>
            `;
       entriesContainer.appendChild(statementElement);

       // Create div for the tags in the entry card
       const tagStyle = document.getElementById(`tagStyle-${result.item._id}`);
       for (let segment of segments) {
         // Status and host country tags
         if (segment.filter === 'Status of the Case') {
           status = segment.subfilter;
           const statusElement = document.createElement('p')
           statusElement.classList.add('card-tag');
           statusElement.textContent = status;
           tagStyle.appendChild(statusElement);
         } else if (segment.filter === 'Host country (Where the violations conducted)') {
           country = segment.subfilter
           const countryElement = document.createElement('p')
           countryElement.classList.add('card-tag');
           countryElement.textContent = country;
           tagStyle.appendChild(countryElement);
         }
       }
     }
   }

   // Function to handle pagination button clicks
   function handlePaginationClick(page) {
     if (page === '«') {
       if (currentPage > 1) {
         currentPage--;
       }
     } else if (page === '»') {
       if (currentPage < Math.ceil(results.length / entriesPerPage)) {
         currentPage++;
       }
     } else {
       currentPage = page;
     }

     displayEntries();
     updatePagination();


   }

   // Function to create a pagination button
   function createPaginationButton(label, isCurrentPage) {
     const listItem = document.createElement('li');
     listItem.classList.add('page-item');
     if (isCurrentPage) {
       listItem.classList.add('active');
       listItem.setAttribute('aria-current', 'page');
     }

     const link = document.createElement('a');
     link.classList.add('page-link');
     link.href = `#results-container`;
     link.textContent = label;
     link.addEventListener('click', () => {
       handlePaginationClick(label);
     });

     if (label === '...' || label === '«' && currentPage === 1) {
       listItem.classList.add('disabled');
       link.removeAttribute('href');
     }

     const totalPages = Math.ceil(results.length / entriesPerPage);
     if (label === '»' && currentPage === totalPages) {
       listItem.classList.add('disabled');
       link.removeAttribute('href');
     }

     listItem.appendChild(link);

     //  // Prevent the default behavior of the click event
     //  link.addEventListener('click', function(event) {
     //    //  event.preventDefault(); // Prevent the default action
     //  });

     return listItem;
   }

   // Function to update the pagination buttons
   function updatePagination() {
     const paginationContainer = document.getElementById('paginationContainer');
     paginationContainer.innerHTML = ''; // Clear the existing pagination buttons

     const paginationList = document.createElement('ul');
     paginationList.classList.add('pagination', 'pagination-sm');

     // Add "Previous" button
     const previousButton = createPaginationButton('«', currentPage === 1);
     paginationList.appendChild(previousButton);

     // Add "First" button
     const firstButton = createPaginationButton(1, currentPage === 1);
     paginationList.appendChild(firstButton);

     //  Add "..." button closer to first button
     if (currentPage - 1 > 3) {
       const dotsButton = createPaginationButton('...', false);
       paginationList.appendChild(dotsButton);
     }

     // Add page buttons
     const totalPages = Math.ceil(results.length / entriesPerPage);
     const maxPagesToShow = 5; // Number of pages to show in the pagination

     for (let i = currentPage - 2; i <= currentPage + 2 && i <= totalPages; i++) {
       if (i > 1 && i < totalPages) {
         const pageButton = createPaginationButton(i, i === currentPage);
         paginationList.appendChild(pageButton);
       };
     }

     //  Add "..." button closer to last button
     if (currentPage < totalPages - 3) {
       const dotsButton = createPaginationButton('...', false);
       paginationList.appendChild(dotsButton);
     }

     // Add "Last" button
     const lastButton = createPaginationButton(totalPages, currentPage === totalPages);
     paginationList.appendChild(lastButton);

     // Add "Next" button
     const nextButton = createPaginationButton('»', currentPage === Math.ceil(results.length / entriesPerPage));
     paginationList.appendChild(nextButton);
     paginationContainer.appendChild(paginationList);
   }


   window.addEventListener('DOMContentLoaded', function() {
     if (window.innerWidth <= 576) {
       scrollToResults();
     } else {
       const searchBar = document.getElementById('searchForm');
       searchBar.scrollIntoView();
     }
   });

   // Initial display of entries and pagination buttons
   displayEntries();
   updatePagination();
 </script>