<% layout('layouts/boilerplate') %>


<div class="row col-12 col-md-11 col-xl-9 mx-auto">
  <div class=" mb-3 back-link"><a href="/statements" class="return-link">

      < Back to All Statements</a>
  </div>

  <div class="col-12  col-xl-9">

    <div class="mb-3">

      <div class="card-body">
        <p class="title-tag">STATEMENT</p>
        <h2 class="card-title mb-4 statement-title">
          <%= statement.title %>
        </h2>

        <!-- ADMIN AREA showing the edit and delete buttons -->
        <% if(currentUser) { %>
        <div class="admin-area-div mb-4">
          <p>ADMIN AREA</p>
          <h3 class="mb-3">Edit or Delete this Statement</h3>
          <p>These buttons only appear for the staff of the project, when they are logged in. <br>Use those buttons to edit or delete the current statement. <br> <br><b>THE DELETE ACTION IS IRREVERSIBLE.</b></p>
          <p class="card-text text-body-primary">
            Current Statement was included in the database by <b><%= statement.author.username %></b>
          </p>
          <% } %>
          <% if(currentUser) { %>
          <a class="btn btn-primary" href="/statements/<%= statement._id %>/edit">EDIT STATEMENT</a>
          <form class="d-inline" action="/statements/<%= statement._id %>?_method=DELETE" method="POST">
            <button class="btn btn-sm btn-danger">DELETE</button>
          </form>
        </div>
        <% } %>

        <h5 class="card-text statement-description">
          <%= statement.description %>
        </h5>

        <!-- Info box of the statement, containing year, country, linked human rights, status -->
        <div class="info-box ">

          <% const hostCountryList = []%>
          <% const linkedHumanRightsList = []%>
          <% let statusString = ''%>

          <% for (let segment of statement.segments) { %>
          <% if(segment.filter==='Host country (Where the Harm Occurred)' ) {%>
          <% hostCountryList.push(segment.subfilter)%>
          <% } else if (segment.filter==='Linked Human Rights/Environmental Issues' ) {%>
          <% linkedHumanRightsList.push(segment.subfilter)%>
          <% } else if (segment.filter==='Status of the Case' ) {%>
          <% statusString = segment.subfilter %>
          <% } %>
          <% } %>
          <div class="row">

            <div class="info-box-left-div col-12 col-md-8">
              <label class="info-box-label"><strong>Linked Human Rights/Environmental Issues</strong></label>
              <div class=" info-box-linked-human">

                <% for (let i = 0; i < linkedHumanRightsList.length; i++) {%>
                <div class="tag-span">
                  <span class=""><%= linkedHumanRightsList[i] %></span>
                </div>
                <% } %>
              </div>

              <label class="info-box-label"><strong>Status</strong></label>
              <div class="info-box-status">

                <div class="tag-span">
                  <span><%= statusString %></span>
                </div>
              </div>



            </div>

            <div class="info-box-right-div col-12 col-md-4">
              <label class="info-box-label"><strong>Host country</strong></label>
              <div class="info-box-countries">
                <% for (let i = 0; i < hostCountryList.length; i++) {%>
                <div class="tag-span">
                  <span><%= hostCountryList[i] %></span>
                </div>
                <% } %>
              </div>

              <label class="info-box-label"><strong>Year</strong></label>
              <div class="info-box-year">
                <div class="tag-span">
                  <span><%= statement.year %></span>
                </div>
              </div>

            </div>


          </div>
        </div>

        <h4 class="summary-tag mb-3">Summary</h4>
        <p class="card-text statement-summary">
          <%= statement.summary %>
        </p>
      </div>
      <% if(statement.pdfFile[0]) {%>
      <h4 class="summary-tag mb-3">Documents</h4>
      <div class="download-container row gy-3">
        <% for (let i = 0; i < statement.pdfFile.length; i++) {%>

        <a href="<%= statement.pdfFile[i].url %>" target="_blank" class="download-link col-12 col-md-6 ">
          <div class="download-btn-container d-flex flex-row align-items-center justify-content-between">
            <h6 class=""><%= statement.pdfFile[i].originalname %></h6>

            <h2 class="download-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="2rem" height="2rem" fill="currentColor" class="bi bi-file-earmark-arrow-down-fill" viewBox="0 0 16 16">
                <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 .293A1 1 0 0 0 9.293 0M9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1m-1 4v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 .708-.708L7.5 11.293V7.5a.5.5 0 0 1 1 0" />
              </svg>
            </h2>
          </div>
        </a>

        <% } %>
      </div>
      <% } %>

    </div>
  </div>

  <!-- Analysis Section with accordion -->
  <div class="col-12  col-xl-9 mb-2">
    <div class="card-body">
      <h4 class="summary-tag mb-3">Analysis</h4>
    </div>
    <div class="accordion mb-4" id="segments-accordion">
      <% const existingFilters=[]; %>
      <% for (let segment of statement.segments) { %>

      <% existingFilters.push(segment.filter) %>
      <% } %>



      <% for(filter in filters){ %>

      <div class="accordion-item" filter-name="<%= filters[filter].filterName %>" <%=existingFilters.includes(filters[filter].filterName) ? "" : "hidden" %>>
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= filter%>" aria-expanded="false" aria-controls="collapse<%= filter%>">
            <%= filters[filter].filterName %>
          </button>
        </h2>
        <% for(let segment of statement.segments){ %>
        <% if(segment.filter===filters[filter].filterName) {%>
        <div id="collapse<%= filter%>" class="accordion-collapse collapse">
          <div class="accordion-body">
            <h5 class="subfilter-accordion-text">
              <%= segment.subfilter %>
            </h5>
            <p><i>
                <%= segment.body %>
              </i></p>
            <!-- ADMIN AREA with delete button for the segment -->

            <% if(currentUser) { %>
            <div class="admin-area-div">
              <p>ADMIN AREA</p>
              <h4 class="mb-3">Delete this Segment</h4>
              <p>This button only appear for the staff of the project, when they are logged in.<br><b>THE DELETE ACTION IS IRREVERSIBLE.</b></p>

              <form action="/statements/<%= statement._id %>/segments/<%= segment._id %>?_method=DELETE" method="POST">
                <button class="btn btn-sm btn-danger">DELETE
                  SEGMENT</button>
              </form>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>
        <% } %>
      </div>

      <% } %>
    </div>

    <!-- Admin area for adding a new segment -->

    <% if(currentUser) {%>
    <div class="admin-area-div">
      <p>ADMIN AREA</p>
      <h2 class="mb-3">Add a Segment</h2>
      <p>This form only appears for the staff of the project, when they are logged in. <br>Use this form to add new segments to the current statement.</p>
      <form action="/statements/<%= statement._id %>/segments" method="POST" class="mb-3 validated-form" novalidate>

        <div class="mb-3">

          <label class="form-label" for="filter"><strong>Filter:</strong></label>
          <select class="form-select" aria-label="Default select example" id="filter" name="segment[filter]">
            <option value="" selected></option>
            <% for (filter in filters) { %>
            <option value="<%= filters[filter].filterName %>" filter-key="<%= filter %>">
              <%= filters[filter].filterName %>
            </option>
            <% } %>
          </select>

        </div>
        <div class="mb-3">

          <label class="form-label" for="subfilter"><strong>Sub-Filter:</strong></label>
          <select class="form-select" aria-label="Default select example" id="subfilter" name="segment[subfilter]">
            <!-- Options will be dynamically populated based on user selection -->
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label" for="body">Segment text:</label>
          <textarea class="form-control" name="segment[body]" id="body" cols="30" rows="10" required></textarea>
        </div>

        <button class="btn btn-success">Submit</button>
      </form>
    </div>
    <% } %>


  </div>
</div>

<script>
  const filters = `<%- JSON.stringify(filters).replace(/'/g, "\\'") %>`;
  const statement = `<%- JSON.stringify(statement)%>`;
</script>

<!-- JavaScript to handle dynamic options in the second select field -->
<script src="/javascripts/populateSubfilters.js"></script>
<!-- <script src="/javascripts/hideUnusedAccordion.js"></script> -->