<% layout('layouts/boilerplate') %>



<div class="row mb-5 mt-5">
  <h1 class="text-center mb-3"><b>Edit Statement</b></h1>
  <div class="col-11 col-md-7 mx-auto">

    <form action="/statements/<%= statement._id %>?_method=PUT" method="POST" novalidate class="validated-form" enctype="multipart/form-data">
      <div class="mb-4">
        <label class="form-label" for="title"><b>TITLE OF THE STATEMENT</b></label>
        <input class="form-control" type="text" id="title" name="statement[title]" value="<%= statement.title  %>" required>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Title can't be empty</div>
      </div>
      <div class="mb-4">
        <label class="form-label" for="description"><b>DESCRIPTION (short description of the statement with a maximum of 300 characters)</b></label>
        <textarea class="form-control" rows="4" type="text" id="description" name="statement[description]" maxlength="300" required><%= statement.description  %></textarea>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Summary can't be empty</div>
      </div>
      <div class="mb-4">
        <label class="form-label" for="year"><b>YEAR</b></label>
        <input class="form-control" type="text" id="year" name="statement[year]" value="<%= statement.year  %>" required>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Location can't be empty</div>
      </div>

      <div class="mb-4">
        <label class="form-label" for="summary"><b>SUMMARY (full summary of the statement)</b></label>
        <textarea class="form-control" rows="12" type="text" id="summary" name="statement[summary]" required><%= statement.summary  %></textarea>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Summary can't be empty</div>
      </div>

      <div class="mb-4 custom-file">
        <label class="form-label" for="summary"><b>UPLOAD NEW FILES RELATED TO THE STATEMENT</b></label>
        <input class="form-control" type="file" id="pdfFile" name="pdfFile" multiple>
        <label for="" class="custom-file-label"></label>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Summary can't be empty</div>
      </div>

      <div class="mb-5 delete-files-div">
        <p>ADMIN AREA</p>
        <h3><b>DELETE EXISTING FILES</b></h3>
        <h5 class="my-3">WARNING! <br>If you select the checkbox for the file and click the "Update Statement" button, the file will be permanently deleted.</h5>
        <h5 class="my-3">Select ONLY the files you want to delete:</h5>
        <% statement.pdfFile.forEach((file, i) => { %>
        <div>
          <input type="checkbox" id="file-<%=i %>" name="deleteFiles[<%=i %>]" value="<%= file.filename %>">
          <label for="file-<%=i %>">File <%= i + 1 %>: <%= file.originalname %></label>
        </div>
        <% }) %>
      </div>

      <div class="mb-5"><button class="btn btn-info">Update Statement</button></div>

    </form>
    <a href="/statements/<%= statement._id %>" class="return-link">

      < Back to Statement</a>
  </div>
</div>